{"song_id":"luca-si-max-colors-002","title":"Jocul celor patru culori","language":"ro","sections":[{"section_id":"s1","kind":"intro","order":1,"lines":[{"line_id":"s1l1","text":"Hai la joc, copii!"},{"line_id":"s1l2","text":"Culorile le știm!"}]},{"section_id":"s2","kind":"verse","order":2,"lines":[{"line_id":"s2l1","text":"Mărul este roșu,"},{"line_id":"s2l2","text":"Roșu, roșu, roșu!"},{"line_id":"s2l3","text":"Soarele-i galben,"},{"line_id":"s2l4","text":"Galben, galben, galben!"},{"line_id":"s2l5","text":"Frunza este verde,"},{"line_id":"s2l6","text":"Verde, verde, verde!"},{"line_id":"s2l7","text":"Cerul e albastru,"},{"line_id":"s2l8","text":"Albastru, albastru!"}]},{"section_id":"s3","kind":"chorus","order":3,"lines":[{"line_id":"s3l1","text":"Roșu, galben, verde, albastru,"},{"line_id":"s3l2","text":"Spune-le și tu!"},{"line_id":"s3l3","text":"Roșu, galben, verde, albastru,"},{"line_id":"s3l4","text":"Le recunoști acu'!"}]},{"section_id":"s4","kind":"verse","order":4,"lines":[{"line_id":"s4l1","text":"Arată ceva roșu!"},{"line_id":"s4l2","text":"Bravo, ai găsit!"},{"line_id":"s4l3","text":"Arată ceva galben!"},{"line_id":"s4l4","text":"Bravo, ai găsit!"},{"line_id":"s4l5","text":"Arată ceva verde!"},{"line_id":"s4l6","text":"Bravo, ai găsit!"},{"line_id":"s4l7","text":"Arată ceva albastru!"},{"line_id":"s4l8","text":"Bravo, ai găsit!"}]},{"section_id":"s5","kind":"chorus","order":5,"lines":[{"line_id":"s5l1","text":"Roșu, galben, verde, albastru,"},{"line_id":"s5l2","text":"Spune-le și tu!"},{"line_id":"s5l3","text":"Roșu, galben, verde, albastru,"},{"line_id":"s5l4","text":"Patru culori știi tu!"}]}]}