{"song_id":"counting-1-to-5-auto-002","title":"Numărăm de la 1 la 5","language":"ro","sections":[{"section_id":"s1","kind":"intro","order":1,"lines":[{"line_id":"s1l1","text":"Hai copii, ne adunăm,"},{"line_id":"s1l2","text":"Cifrele le învățăm!"},{"line_id":"s1l3","text":"De la unu pân’ la cinci,"},{"line_id":"s1l4","text":"Le rostim cu toții-aici!"}]},{"section_id":"s2","kind":"verse","order":2,"lines":[{"line_id":"s2l1","text":"1 e unu — un balon,"},{"line_id":"s2l2","text":"Saltă vesel către nori."},{"line_id":"s2l3","text":"2 e doi — doi ursuleți,"},{"line_id":"s2l4","text":"Mici, pufoși și drăgăleți."},{"line_id":"s2l5","text":"3 e trei — trei iepurași,"},{"line_id":"s2l6","text":"Țop, țop, țop, sunt poznași."},{"line_id":"s2l7","text":"Numărăm și repetăm:"},{"line_id":"s2l8","text":"Unu, doi și trei cântăm!"}]},{"section_id":"s3","kind":"chorus","order":3,"lines":[{"line_id":"s3l1","text":"1, 2, 3, 4, 5,"},{"line_id":"s3l2","text":"Numărăm voioși aici!"},{"line_id":"s3l3","text":"Unu, doi, trei, patru, cinci,"},{"line_id":"s3l4","text":"Bate palmele de cinci!"},{"line_id":"s3l5","text":"Unu, doi, trei, patru, cinci,"},{"line_id":"s3l6","text":"Cifrele le știi de mici!"},{"line_id":"s3l7","text":"1, 2, 3, 4, 5,"},{"line_id":"s3l8","text":"Hai să le mai spui o dată!"}]},{"section_id":"s4","kind":"verse","order":4,"lines":[{"line_id":"s4l1","text":"4 e patru — patru flori,"},{"line_id":"s4l2","text":"Colorate-n multe culori."},{"line_id":"s4l3","text":"5 e cinci — cinci steluțe,"},{"line_id":"s4l4","text":"Strălucesc tare drăguțe."},{"line_id":"s4l5","text":"Arată cifra 4 acum,"},{"line_id":"s4l6","text":"Patru pași facem pe drum."},{"line_id":"s4l7","text":"Arată cifra 5 apoi,"},{"line_id":"s4l8","text":"Și numără iar cu noi!"}]},{"section_id":"s5","kind":"chorus","order":5,"lines":[{"line_id":"s5l1","text":"1, 2, 3, 4, 5,"},{"line_id":"s5l2","text":"Numărăm voioși aici!"},{"line_id":"s5l3","text":"Unu, doi, trei, patru, cinci,"},{"line_id":"s5l4","text":"Bate palmele de cinci!"},{"line_id":"s5l5","text":"Unu, doi, trei, patru, cinci,"},{"line_id":"s5l6","text":"Cifrele le știi de mici!"},{"line_id":"s5l7","text":"1, 2, 3, 4, 5,"},{"line_id":"s5l8","text":"Hai să le mai spui o dată!"}]},{"section_id":"s6","kind":"outro","order":6,"lines":[{"line_id":"s6l1","text":"Unu, doi, trei, patru, cinci,"},{"line_id":"s6l2","text":"Le-am aflat pe toate-aici!"},{"line_id":"s6l3","text":"Le vedem și le numim,"},{"line_id":"s6l4","text":"Și cu drag le numărăm!"}]}]}