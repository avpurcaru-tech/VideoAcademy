{"song_id":"counting-1-to-5","title":"Unu, doi, trei, patru, cinci!","language":"ro","sections":[{"section_id":"s1","kind":"intro","order":1,"lines":[{"line_id":"s1l1","text":"Hai să numărăm voios!"},{"line_id":"s1l2","text":"De la unu pân’ la cinci!"}]},{"section_id":"s2","kind":"verse","order":2,"lines":[{"line_id":"s2l1","text":"Unu — un soare sus,"},{"line_id":"s2l2","text":"Unu, unu — l-am văzut!"},{"line_id":"s2l3","text":"Doi — doi nori pufoși,"},{"line_id":"s2l4","text":"Unu, doi — ce bucuroși!"},{"line_id":"s2l5","text":"Trei — trei flori în rând,"},{"line_id":"s2l6","text":"Unu, doi, trei — le număr cântând!"}]},{"section_id":"s3","kind":"chorus","order":3,"lines":[{"line_id":"s3l1","text":"Unu, doi, trei,"},{"line_id":"s3l2","text":"Patru, cinci!"},{"line_id":"s3l3","text":"Numărăm ușor aici!"},{"line_id":"s3l4","text":"Unu, doi, trei,"},{"line_id":"s3l5","text":"Patru, cinci!"},{"line_id":"s3l6","text":"Bravo! Știm să numărăm!"}]},{"section_id":"s4","kind":"verse","order":4,"lines":[{"line_id":"s4l1","text":"Patru — patru mingi ușoare,"},{"line_id":"s4l2","text":"Le numărăm pe fiecare:"},{"line_id":"s4l3","text":"Unu, doi, trei, patru!"},{"line_id":"s4l4","text":"Cinci — cinci stele sclipitoare,"},{"line_id":"s4l5","text":"Le numărăm pe fiecare:"},{"line_id":"s4l6","text":"Unu, doi, trei, patru, cinci!"}]},{"section_id":"s5","kind":"chorus","order":5,"lines":[{"line_id":"s5l1","text":"Unu, doi, trei,"},{"line_id":"s5l2","text":"Patru, cinci!"},{"line_id":"s5l3","text":"Numărăm ușor aici!"},{"line_id":"s5l4","text":"Unu, doi, trei,"},{"line_id":"s5l5","text":"Patru, cinci!"},{"line_id":"s5l6","text":"Bravo! Știm să numărăm!"}]},{"section_id":"s6","kind":"bridge","order":6,"lines":[{"line_id":"s6l1","text":"Arată un degețel!"},{"line_id":"s6l2","text":"Arată două — tot la fel!"},{"line_id":"s6l3","text":"Trei, patru, apoi cinci,"},{"line_id":"s6l4","text":"Toate degetele-s aici!"}]},{"section_id":"s7","kind":"outro","order":7,"lines":[{"line_id":"s7l1","text":"Unu, doi, trei, patru, cinci!"},{"line_id":"s7l2","text":"Ce frumos ai numărat!"},{"line_id":"s7l3","text":"Unu, doi, trei, patru, cinci!"},{"line_id":"s7l4","text":"Bravo, bravo, ai învățat!"}]}]}